#!/bin/bash
# myos — MyOS 启动器（安装到 /usr/bin/myos）
#
# 先加载 ROS Noetic 环境（提供 rospy / cv_bridge / rosbag / rviz），
# 再启动面板。若想用自带的 Python 环境（如 conda），可指定解释器：
#     MYOS_PYTHON=/home/xxx/miniconda3/envs/pcdet/bin/python myos

PY="${MYOS_PYTHON:-python3}"

if [ -f /opt/ros/noetic/setup.bash ]; then
    # shellcheck disable=SC1091
    source /opt/ros/noetic/setup.bash
fi

exec "$PY" /opt/myos/main.py "$@"
